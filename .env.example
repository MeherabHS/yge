# Brevo transactional email configuration for /api/contact
# Create an API key in Brevo and verify the sender address before deployment.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=YGE Website

# Optional. Defaults to youthforagreenearth@gmail.com.
BREVO_RECIPIENT_EMAIL=youthforagreenearth@gmail.com

# Durable contact-form rate limiting. Required in production.
# Create a Redis database at Upstash and copy its REST credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only HMAC secret. Generate at least 32 random characters and rotate carefully.
YGE_SECURITY_SECRET=

# Exact comma-separated HTTPS origins for verified staging/preview environments.
# The canonical apex and www production origins are built in.
CONTACT_ALLOWED_ORIGINS=

# Optional global successful-submission ceiling (defaults to 100 per hour).
CONTACT_GLOBAL_LIMIT=100
CONTACT_GLOBAL_WINDOW_SECONDS=3600

# Self-hosting only. Enable after Nginx overwrites this header and direct origin
# access is blocked. Vercel is detected automatically and uses x-forwarded-for.
CONTACT_TRUST_PROXY_HEADERS=false
CONTACT_CLIENT_IP_HEADER=x-real-ip

# Canonical production origin used for metadata and contact-origin checks.
NEXT_PUBLIC_SITE_URL=https://youthforagreenearth.org
